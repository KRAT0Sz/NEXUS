@page "/replays"

<PageTitle>Match Replays - Project KONGOR</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="px-4 px-sm-6 pt-8">

    @* Page Header *@
    <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="mb-6 animate-fade-in">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.VideoLibrary" Size="Size.Large" Color="Color.Primary" />
            <MudText Typo="Typo.h4" Class="section-header">Match Replays</MudText>
        </MudStack>
        <MudText Typo="Typo.body1" Align="Align.Center" Color="Color.Secondary" Style="max-width: 600px;">
            Search and download recorded match replays directly to view in your Heroes Of Newerth client.
        </MudText>
    </MudStack>

    @* Search Card *@
    <MudCard Class="glass-card pa-4 mb-6 animate-fade-in-delay-1" Elevation="0">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudTextField @bind-Value="SearchTerm" Placeholder="Search by Match ID, Map or Hero..."
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Variant="Variant.Outlined" Immediate="true" Class="flex-grow-1" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="glow-button" OnClick="FilterReplays">
                Search
            </MudButton>
        </MudStack>
    </MudCard>

    @* Replays Table *@
    <MudCard Class="glass-card pa-4 mb-6 animate-fade-in-delay-2" Elevation="0">
        <MudTable Items="@FilteredReplays" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0">
            <HeaderContent>
                <MudTh Style="width: 120px;">Match ID</MudTh>
                <MudTh>Map</MudTh>
                <MudTh>Game Mode</MudTh>
                <MudTh Style="width: 140px;">Duration</MudTh>
                <MudTh Style="width: 160px;">Date</MudTh>
                <MudTh Style="width: 180px;">Action</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Match ID">
                    <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Outlined">#@context.MatchID</MudChip>
                </MudTd>
                <MudTd DataLabel="Map">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudIcon Icon="@Icons.Material.Filled.Map" Size="Size.Small" Color="Color.Secondary" />
                        <MudText Typo="Typo.body2">@context.MapName</MudText>
                    </MudStack>
                </MudTd>
                <MudTd DataLabel="Game Mode">
                    <MudText Typo="Typo.body2">@context.GameMode</MudText>
                </MudTd>
                <MudTd DataLabel="Duration">
                    <MudText Typo="Typo.body2">@context.Duration</MudText>
                </MudTd>
                <MudTd DataLabel="Date">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@context.RecordedDate</MudText>
                </MudTd>
                <MudTd DataLabel="Action">
                    <MudButton Href="@context.DownloadURL" Target="_blank" Variant="Variant.Filled"
                               Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Download">
                        Download
                    </MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudCard>

</MudContainer>

@code {
    public record ReplayItem(int MatchID, string MapName, string GameMode, string Duration, string RecordedDate, string DownloadURL);

    private string SearchTerm { get; set; } = string.Empty;

    private List<ReplayItem> AllReplays { get; set; } =
    [
        new (100452, "Forests of Caldavar", "All Pick", "42:15", "2026-11-13", "https://replays.projectkongor.com/replays/M100452.honreplay"),
        new (100451, "Mid Wars", "Blind Ban", "28:40", "2026-11-13", "https://replays.projectkongor.com/replays/M100451.honreplay"),
        new (100450, "Grimm's Crossing (3v3)", "Lock Pick", "35:10", "2026-11-12", "https://replays.projectkongor.com/replays/M100450.honreplay"),
        new (100449, "Forests of Caldavar", "Captains Pick", "51:02", "2026-11-12", "https://replays.projectkongor.com/replays/M100449.honreplay"),
        new (100448, "Rift Wars", "All Random", "22:18", "2026-11-11", "https://replays.projectkongor.com/replays/M100448.honreplay")
    ];

    private IEnumerable<ReplayItem> FilteredReplays => string.IsNullOrWhiteSpace(SearchTerm)
        ? AllReplays
        : AllReplays.Where(r => r.MatchID.ToString().Contains(SearchTerm) ||
                                r.MapName.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase) ||
                                r.GameMode.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase));

    private void FilterReplays()
    {
    }
}
