    [
        new (1, "MoonMeander", "tdM", 2045.2, 342, 85),
        new (2, "AngryTestie", "EZ", 2012.8, 412, 120),
        new (3, "KheZu", "BM", 1998.4, 290, 78),
        new (4, "Mynuts", "tdM", 1982.0, 250, 80),
        new (5, "bkid", "5", 1965.5, 310, 115),
        new (6, "Tralfamadore", "coL", 1954.2, 280, 105),
        new (7, "Scandal", "RoX", 1941.0, 220, 92),
        new (8, "Sender", "sG", 1935.6, 210, 88),
        new (9, "slickz", "fntc", 1928.1, 195, 75),
        new (10, "insania", "sG", 1920.4, 240, 110)
    ];

    private List<LeaderboardDisplayItem> CasualEntries { get; set; } =
    [
        new (1, "TestieCasual", "EZ", 1850.5, 120, 25),
        new (2, "MidWarsKing", "MW", 1820.0, 195, 55),
        new (3, "CasualHero", "FUN", 1795.3, 140, 48)
    ];
}
