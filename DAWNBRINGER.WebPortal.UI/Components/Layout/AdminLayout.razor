@inherits LayoutComponentBase

<MudThemeProvider @ref="ThemeProvider" Theme="Theme" IsDarkMode="IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="@ThemeClass">
<MudLayout>
    <MudAppBar Elevation="0" Fixed="true" Class="kongor-appbar">
        <MudContainer MaxWidth="MaxWidth.Large" Class="d-flex align-center px-4 px-sm-6 py-0">
            <MudHidden Breakpoint="Breakpoint.LgAndUp">
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" />
            </MudHidden>

            <MudButton Href="/" Color="Color.Inherit" Variant="Variant.Text" Class="kongor-home-button">
                <MudImage Src="images/home.png" Alt="Project KONGOR" Width="40" Height="40" Class="mr-2 logo-glow" />
                Home
            </MudButton>

            <MudSpacer />

            <MudText Typo="Typo.h6" Color="Color.Primary" Class="mr-4">Admin</MudText>

            <MudSpacer />

            <MudHidden Breakpoint="Breakpoint.MdAndDown">
                <MudStack Row="true" Class="align-center gap-2">
                    <MudButton Href="/account" Color="AppBarButtonColour" Variant="Variant.Outlined">Account</MudButton>
                    <MudButton Color="AppBarButtonColour" Variant="Variant.Outlined" OnClick="HandleLogOut">Log Out</MudButton>
                </MudStack>
            </MudHidden>

            <MudSpacer />

            <MudIconButton Icon="@ThemeIcon" Color="Color.Inherit" Edge="Edge.End" Size="Size.Large" OnClick="ToggleTheme" />
        </MudContainer>
    </MudAppBar>

    <MudDrawer @bind-Open="DrawerOpen" Elevation="1" Variant="DrawerVariant.Temporary" ClipMode="DrawerClipMode.Always">
        <MudNavMenu>
            <MudText Typo="Typo.h6" Color="Color.Primary" Class="pa-4">Admin Panel</MudText>
            <MudDivider Class="mb-2" />

            <MudNavLink Href="/admin" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>
            <MudNavLink Href="/admin/users" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.People">Users</MudNavLink>
            <MudNavLink Href="/admin/accounts" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Badge">Accounts</MudNavLink>
            <MudNavLink Href="/admin/clans" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Groups">Clans</MudNavLink>

            <MudDivider Class="my-4" />

            <MudNavLink Icon="@ThemeIcon" OnClick="ToggleTheme">@(IsDarkMode ? "Light Mode" : "Dark Mode")</MudNavLink>
            <MudNavLink Href="/account" Icon="@Icons.Material.Filled.ManageAccounts">Account</MudNavLink>
            <MudNavLink Icon="@Icons.Material.Filled.Logout" OnClick="HandleLogOut">Log Out</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent Style="@ContentStyle">
        <div class="d-flex flex-column" style="min-height: calc(100vh - 64px);">
            <div class="pt-6 flex-grow-1 d-flex flex-column justify-center">
                <CascadingValue Name="IsDarkMode" Value="IsDarkMode">
                    @Body
                </CascadingValue>
            </div>

            <footer class="kongor-footer">
                <MudContainer MaxWidth="MaxWidth.Large" Class="px-4 px-sm-6">
                    <hr class="section-divider" />
                    <MudStack Row="true" Justify="Justify.Center" Class="pb-2 flex-wrap gap-6">
                        <MudLink Href="/" Typo="Typo.body2" Color="Color.Inherit">Home</MudLink>
                        <MudLink Href="/downloads" Typo="Typo.body2" Color="Color.Inherit">Downloads</MudLink>
                        <MudLink Href="https://codex.kongor.net" Target="_blank" Typo="Typo.body2" Color="Color.Inherit">Knowledge Base</MudLink>
                        <MudLink Href="https://discord.com/invite/N6pKzGDqUH" Target="_blank" Typo="Typo.body2" Color="Color.Inherit">Discord</MudLink>
                    </MudStack>

                    <MudStack Spacing="0" AlignItems="AlignItems.Center" Class="pt-4 pb-6">
                        <MudText Typo="Typo.caption" Align="Align.Center">
                            Copyright: 2022-@DateTime.UtcNow.Year Project KONGOR | Contact: project.kongor@proton.me
                        </MudText>
                        <MudText Typo="Typo.caption" Align="Align.Center" Color="Color.Secondary">
                            Any and all of the Heroes Of Newerth intellectual property is owned exclusively by Garena.
                        </MudText>
                    </MudStack>
                </MudContainer>
            </footer>
        </div>
    </MudMainContent>
</MudLayout>
</div>

