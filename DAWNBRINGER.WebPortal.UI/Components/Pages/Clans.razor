@page "/clans"

<PageTitle>Clan Hub - Project KONGOR</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="px-4 px-sm-6 pt-8">

    @* Page Header *@
    <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="mb-6 animate-fade-in">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Shield" Size="Size.Large" Color="Color.Primary" />
            <MudText Typo="Typo.h4" Class="section-header">Clan Hub</MudText>
        </MudStack>
        <MudText Typo="Typo.body1" Align="Align.Center" Color="Color.Secondary" Style="max-width: 600px;">
            Explore registered clans, roster rankings, and competitive teams in Newerth.
        </MudText>
    </MudStack>

    @* Clan Directory Table *@
    <MudCard Class="glass-card pa-4 mb-6 animate-fade-in-delay-1" Elevation="0">
        <MudTable Items="@RegisteredClans" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0">
            <HeaderContent>
                <MudTh Style="width: 100px;">Tag</MudTh>
                <MudTh>Clan Name</MudTh>
                <MudTh Style="width: 160px;">Leader</MudTh>
                <MudTh Style="width: 140px;">Members</MudTh>
                <MudTh Style="width: 160px;">Created Date</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Tag">
                    <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Outlined">[@context.Tag]</MudChip>
                </MudTd>
                <MudTd DataLabel="Clan Name">
                    <MudText Typo="Typo.body1" Class="font-weight-bold">@context.Name</MudText>
                </MudTd>
                <MudTd DataLabel="Leader">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@context.LeaderName</MudText>
                </MudTd>
                <MudTd DataLabel="Members">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Small" Color="Color.Primary" />
                        <MudText Typo="Typo.body2">@context.MemberCount</MudText>
                    </MudStack>
                </MudTd>
                <MudTd DataLabel="Created Date">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@context.CreatedDate</MudText>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudCard>

</MudContainer>

@code {
    public record ClanDirectoryItem(string Tag, string Name, string LeaderName, int MemberCount, string CreatedDate);

    private List<ClanDirectoryItem> RegisteredClans { get; set; } =
    [
        new ("tdM", "team discover More", "MoonMeander", 15, "2022-10-15"),
        new ("EZ", "Easy Mode Gaming", "AngryTestie", 24, "2022-11-01"),
        new ("sG", "stay Green", "insania", 18, "2023-01-20"),
        new ("coL", "Complexity Gaming", "Tralfamadore", 12, "2023-03-10"),
        new ("BM", "Bad Monkey Gaming", "KheZu", 10, "2023-05-04")
    ];
}
