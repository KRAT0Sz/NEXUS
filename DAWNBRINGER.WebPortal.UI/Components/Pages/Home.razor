@page "/"

<PageTitle>Project KONGOR</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="px-4 px-sm-6 py-0">

    @* Hero Section *@
    <div class="hero-section animate-fade-in">
        <div class="hero-bg-gradient"></div>
        <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="animate-fade-in">
                <MudImage Src="images/home.png" Alt="Project KONGOR" Width="56" Height="56" Class="logo-glow" />
                <MudText Typo="Typo.h1" Align="Align.Center" Class="font-scurlock hero-title" Color="Color.Primary">Project KONGOR</MudText>
            </MudStack>
            <MudText Typo="Typo.h5" Align="Align.Center" Class="animate-fade-in-delay-1">
                keeping the real Heroes Of Newerth alive since 2022
            </MudText>
            <MudText Typo="Typo.subtitle1" Align="Align.Center" Color="Color.Secondary" Class="animate-fade-in-delay-2">
                passionately, by the community for the community
            </MudText>
            <MudStack Row="true" Spacing="2" Class="mt-2 animate-fade-in-delay-3">
                <MudButton Href="/register"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Large"
                           Class="glow-button"
                           StartIcon="@Icons.Material.Filled.PersonAdd">
                    Get Started
                </MudButton>
                <MudButton Href="https://discord.com/invite/N6pKzGDqUH"
                           Target="_blank"
                           Variant="Variant.Outlined"
                           Color="Color.Primary"
                           Size="Size.Large"
                           StartIcon="@Icons.Custom.Brands.Discord">
                    Join Discord
                </MudButton>
            </MudStack>
        </MudStack>
    </div>

    @* Downloads & Community Section *@
    <MudGrid Spacing="4" Class="mb-6 animate-fade-in-delay-1">
        <MudItem xs="12" md="6">
            <MudCard Class="glass-card pa-5" Elevation="0" Style="height: 100%;">
                <MudCardContent>
                    <MudStack Spacing="3">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <div class="hero-icon-wrap discord-glow">
                                <MudIcon Icon="@Icons.Material.Filled.Download" Size="Size.Medium" Color="Color.Primary" />
                            </div>
                            <MudText Typo="Typo.h5">Downloads</MudText>
                        </MudStack>
                        <MudText Typo="Typo.body1" Color="Color.Secondary">
                            Get the tools and distributions you need to start playing Heroes Of Newerth or host your own match servers.
                        </MudText>
                    </MudStack>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Href="/downloads" Variant="Variant.Filled" Color="Color.Primary" Class="glow-button" EndIcon="@Icons.Material.Filled.ArrowForward">
                        Browse Downloads
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudCard Class="glass-card pa-5" Elevation="0" Style="height: 100%;">
                <MudCardContent>
                    <MudStack Spacing="3">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <div class="hero-icon-wrap discord-glow">
                                <MudIcon Icon="@Icons.Material.Filled.Groups" Size="Size.Medium" Color="Color.Primary" />
                            </div>
                            <MudText Typo="Typo.h5">Community</MudText>
                        </MudStack>
                        <MudText Typo="Typo.body1" Color="Color.Secondary">
                            Join fellow players and contributors in our community spaces. Get help, share strategies,
                            find matches, and stay up to date with the latest Project KONGOR news.
                        </MudText>
                    </MudStack>
                </MudCardContent>
                <MudCardActions Class="gap-2">
                    <MudButton Href="https://discord.com/invite/N6pKzGDqUH" Target="_blank" Variant="Variant.Filled" Color="Color.Primary" Class="glow-button" StartIcon="@Icons.Custom.Brands.Discord">
                        Discord
                    </MudButton>
                    <MudButton Href="https://www.reddit.com/r/newerth/" Target="_blank" Variant="Variant.Filled" Color="Color.Primary" Class="glow-button" StartIcon="@Icons.Custom.Brands.Reddit">
                        Reddit
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>

    @if (false)
    {
    <hr class="section-divider" />

    @* Source Code Section *@
    <MudCard Class="glass-card pa-6 mb-6 animate-fade-in-delay-2" Elevation="0">
        <MudStack AlignItems="AlignItems.Center" Spacing="4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <div class="hero-icon-wrap discord-glow">
                    <MudIcon Icon="@Icons.Custom.Brands.GitHub" Size="Size.Medium" Color="Color.Primary" />
                </div>
                <MudText Typo="Typo.h5" Align="Align.Center" Class="section-header">Source Code</MudText>
            </MudStack>
            <MudText Typo="Typo.body1" Align="Align.Center" Color="Color.Secondary" Style="max-width: 600px;">
                Project KONGOR is open source. Explore our repositories, contribute code, report issues, or fork the projects to run your own services.
            </MudText>
        </MudStack>

        <MudGrid Spacing="3" Class="mt-4" Justify="Justify.Center">
            <MudItem xs="12" sm="6" md="3">
                <MudCard Class="glass-card-inner pa-4" Elevation="0" Style="height: 100%;">
                    <MudCardContent>
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.h6" Color="Color.Primary">NEXUS</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Web Portal & API</MudText>
                        </MudStack>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Href="https://github.com/Project-KONGOR-Open-Source/NEXUS" Target="_blank" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" EndIcon="@Icons.Material.Filled.OpenInNew">
                            View Repository
                        </MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudCard Class="glass-card-inner pa-4" Elevation="0" Style="height: 100%;">
                    <MudCardContent>
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.h6" Color="Color.Primary">WILLOWMAKER</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Game Client Launcher</MudText>
                        </MudStack>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Href="https://github.com/Project-KONGOR-Open-Source/WILLOWMAKER" Target="_blank" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" EndIcon="@Icons.Material.Filled.OpenInNew">
                            View Repository
                        </MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudCard Class="glass-card-inner pa-4" Elevation="0" Style="height: 100%;">
                    <MudCardContent>
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.h6" Color="Color.Primary">COMPEL</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Match Server Launcher</MudText>
                        </MudStack>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Href="https://github.com/Project-KONGOR-Open-Source/COMPEL" Target="_blank" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" EndIcon="@Icons.Material.Filled.OpenInNew">
                            View Repository
                        </MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudCard Class="glass-card-inner pa-4" Elevation="0" Style="height: 100%;">
                    <MudCardContent>
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.h6" Color="Color.Primary">CODEX</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Project KONGOR Knowledge Base</MudText>
                        </MudStack>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Href="https://github.com/Project-KONGOR-Open-Source/CODEX" Target="_blank" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" EndIcon="@Icons.Material.Filled.OpenInNew">
                            View Repository
                        </MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        </MudGrid>
    </MudCard>

    <hr class="section-divider" />

    @* Knowledge Base Section *@
    <MudCard Class="glass-card pa-6 mb-6 animate-fade-in-delay-3" Elevation="0">
        <MudCardContent>
            <MudStack AlignItems="AlignItems.Center" Spacing="3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <div class="hero-icon-wrap discord-glow">
                        <MudIcon Icon="@Icons.Material.Filled.MenuBook" Size="Size.Medium" Color="Color.Primary" />
                    </div>
                    <MudText Typo="Typo.h5" Align="Align.Center" Class="section-header">Knowledge Base</MudText>
                </MudStack>
                <MudText Typo="Typo.body1" Align="Align.Center" Color="Color.Secondary" Style="max-width: 600px;">
                    Find comprehensive documentation on all aspects of Project KONGOR. From self-hosting guides for technical users
                    to in-depth game mechanics, the Knowledge Base has you covered.
                </MudText>
            </MudStack>
        </MudCardContent>
    </MudCard>

    <hr class="section-divider" />
    }

    @* Timeline Section *@
    <MudCard Class="glass-card pa-6 animate-fade-in-delay-4" Elevation="0">
        <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <div class="hero-icon-wrap discord-glow">
                    <MudIcon Icon="@Icons.Material.Filled.Timeline" Size="Size.Medium" Color="Color.Primary" />
                </div>
                <MudText Typo="Typo.h5" Align="Align.Center" Class="section-header">Timeline</MudText>
            </MudStack>
            <MudText Typo="Typo.body1" Align="Align.Center" Color="Color.Secondary">Key milestones in Project KONGOR's journey</MudText>
        </MudStack>

        <MudTimeline TimelinePosition="TimelinePosition.Alternate">
            <MudTimelineItem Color="Color.Primary" Variant="Variant.Filled">
                <ItemOpposite>
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">TODO Date</MudText>
                </ItemOpposite>
                <ItemContent>
                    <MudCard Class="timeline-card pa-3" Elevation="0">
                        <MudText Typo="Typo.h6">TODO #1</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Placeholder event description. Replace with actual milestone.</MudText>
                    </MudCard>
                </ItemContent>
            </MudTimelineItem>

            <MudTimelineItem Color="Color.Secondary" Variant="Variant.Filled">
                <ItemOpposite>
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">TODO Date</MudText>
                </ItemOpposite>
                <ItemContent>
                    <MudCard Class="timeline-card pa-3" Elevation="0">
                        <MudText Typo="Typo.h6">TODO #2</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Placeholder event description. Replace with actual milestone.</MudText>
                    </MudCard>
                </ItemContent>
            </MudTimelineItem>

            <MudTimelineItem Color="Color.Primary" Variant="Variant.Filled">
                <ItemOpposite>
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">TODO Date</MudText>
                </ItemOpposite>
                <ItemContent>
                    <MudCard Class="timeline-card pa-3" Elevation="0">
                        <MudText Typo="Typo.h6">TODO #3</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Placeholder event description. Replace with actual milestone.</MudText>
                    </MudCard>
                </ItemContent>
            </MudTimelineItem>

            <MudTimelineItem Color="Color.Secondary" Variant="Variant.Filled">
                <ItemOpposite>
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">TODO Date</MudText>
                </ItemOpposite>
                <ItemContent>
                    <MudCard Class="timeline-card pa-3" Elevation="0">
                        <MudText Typo="Typo.h6">TODO #4</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Placeholder event description. Replace with actual milestone.</MudText>
                    </MudCard>
                </ItemContent>
            </MudTimelineItem>

            <MudTimelineItem Color="Color.Primary" Variant="Variant.Filled">
                <ItemOpposite>
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">TODO Date</MudText>
                </ItemOpposite>
                <ItemContent>
                    <MudCard Class="timeline-card pa-3" Elevation="0">
                        <MudText Typo="Typo.h6">TODO #5</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Placeholder event description. Replace with actual milestone.</MudText>
                    </MudCard>
                </ItemContent>
            </MudTimelineItem>
        </MudTimeline>
    </MudCard>

</MudContainer>

<style>
    .hero-bg-gradient {
        position: absolute;
        inset: 0;
        background:
            radial-gradient(ellipse 80% 50% at 50% -10%, rgba(var(--kongor-primary-rgb), 0.15) 0%, transparent 60%),
            radial-gradient(ellipse 60% 40% at 80% 50%, rgba(var(--kongor-primary-rgb), 0.05) 0%, transparent 50%),
            radial-gradient(ellipse 60% 40% at 20% 50%, rgba(var(--kongor-primary-rgb), 0.05) 0%, transparent 50%);
        pointer-events: none;
        z-index: 0;
    }

    .hero-section {
        position: relative;
        padding: 3rem 2rem 4rem;
        text-align: center;
        overflow: hidden;
        margin-bottom: 2.5rem;
    }

    .hero-section .mud-stack {
        position: relative;
        z-index: 1;
    }

    .hero-icon-wrap {
        width: 40px;
        height: 40px;
        border-radius: 8px;
        background: rgba(var(--kongor-primary-rgb), 0.12);
        border: 1px solid rgba(var(--kongor-primary-rgb), 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>
