@page "/discord/password-reset"

@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

@code {
    protected override async Task OnInitializedAsync()
    {
        Uri currentUri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        string apiBaseUrl = "https://" + currentUri.Host + ":5556";
        string redirectUrl = apiBaseUrl + "/Discord/PasswordReset";
        await JSRuntime.InvokeVoidAsync("window.location.replace", redirectUrl);
    }
}
