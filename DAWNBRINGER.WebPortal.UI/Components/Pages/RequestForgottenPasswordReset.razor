@page "/password/recover"

@inject PortalAuthenticationService AuthenticationService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>Forgotten Password - Project KONGOR</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="px-4 py-12">
    <div class="re-hero">
        <div class="re-icon-wrap">
            <MudIcon Icon="@Icons.Material.Filled.LockReset" Size="Size.Medium" Class="re-icon" />
        </div>
        <MudText Typo="Typo.h4" Class="re-title">Forgotten Password</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="re-subtitle">
            Reset your password using your linked Discord account.
        </MudText>
    </div>

    <div class="re-form-card">
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4" Icon="@Icons.Custom.Brands.Discord">
            <MudText Typo="Typo.body2">
                Your Discord account must be linked to your Project KONGOR account.
                If you have not linked a Discord account, please contact support.
            </MudText>
        </MudAlert>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Large"
                   FullWidth="true"
                   OnClick="@HandleDiscordReset"
                   StartIcon="@Icons.Custom.Brands.Discord"
                   Class="glow-button">
            Reset via Discord
        </MudButton>
    </div>

    <MudText Align="Align.Center" Class="re-footer">
        Remember your password?
        <MudLink Href="/login" Color="Color.Primary" Underline="Underline.Always">Log in here</MudLink>
    </MudText>
</MudContainer>

<style>
    .re-hero {
        text-align: center;
        margin-bottom: 1.75rem;
    }

    .re-icon-wrap {
        width: 56px;
        height: 56px;
        margin: 0 auto 1rem;
        border-radius: 50%;
        background: rgba(var(--kongor-primary-rgb), 0.12);
        border: 1px solid rgba(var(--kongor-primary-rgb), 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        animation: re-float 3s ease-in-out infinite;
    }

    @@keyframes re-float {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-4px); }
    }

    .re-icon {
        font-size: 1.5rem;
        color: var(--kongor-primary);
    }

    .re-title {
        font-weight: 700;
        margin-bottom: 0.375rem;
    }

    .re-subtitle {
        max-width: 300px;
        margin: 0 auto;
        line-height: 1.6;
    }

    .re-form-card {
        background: rgba(var(--kongor-surface-rgb), 0.55);
        border: 1px solid rgba(var(--kongor-primary-rgb), 0.08);
        border-radius: 8px;
        padding: 1.5rem;
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        margin-bottom: 1.5rem;
        width: 100%;
    }

    :global(.re-form-card) .mud-input-control {
        margin-bottom: 0 !important;
    }

    :global(.re-form-card) .mud-input {
        font-size: 0.9375rem;
        background: rgba(var(--kongor-surface-rgb), 0.3) !important;
        border-radius: 4px;
    }

    .re-footer {
        color: rgba(var(--kongor-surface-rgb), 0.6);
        font-size: 0.875rem;
    }
</style>

@code {

    private void HandleDiscordReset()
    {
        NavigationManager.NavigateTo("/discord/password-reset", forceLoad: true);
    }
}
